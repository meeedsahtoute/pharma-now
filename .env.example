GEMINI_API_KEY=

# OpenAI API Key (Alternative)
OPENAI_API_KEY=

# Groq API Key (Alternative)
GROQ_API_KEY=

# OpenRouter API Key (Alternative)
OPENROUTER_API_KEY=

# Generic AI API Key
AI_API_KEY=
